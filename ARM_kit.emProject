<!DOCTYPE CrossStudio_Project_File>
<solution Name="ARM_kit" target="8" version="2">

  <!-- Solution-level configurations – appear in the toolbar dropdown -->
  <configuration
    Name="F411 Debug"
    c_preprocessor_definitions="DEBUG"
    gcc_debugging_level="Level 3"
    gcc_omit_frame_pointer="Yes"
    gcc_optimization_level="None" />
  <configuration
    Name="F411 Release"
    c_preprocessor_definitions="NDEBUG"
    gcc_debugging_level="Level 2"
    gcc_omit_frame_pointer="Yes"
    gcc_optimization_level="Level 2 balanced"
    link_dedupe_code="Yes" />
  <configuration
    Name="F407 Debug"
    c_preprocessor_definitions="DEBUG"
    gcc_debugging_level="Level 3"
    gcc_omit_frame_pointer="Yes"
    gcc_optimization_level="None" />
  <configuration
    Name="F407 Release"
    c_preprocessor_definitions="NDEBUG"
    gcc_debugging_level="Level 2"
    gcc_omit_frame_pointer="Yes"
    gcc_optimization_level="Level 2 balanced"
    link_dedupe_code="Yes" />
  <configuration
    Name="G071 Debug"
    c_preprocessor_definitions="DEBUG"
    gcc_debugging_level="Level 3"
    gcc_omit_frame_pointer="Yes"
    gcc_optimization_level="None" />
  <configuration
    Name="G071 Release"
    c_preprocessor_definitions="NDEBUG"
    gcc_debugging_level="Level 2"
    gcc_omit_frame_pointer="Yes"
    gcc_optimization_level="Level 2 balanced"
    link_dedupe_code="Yes" />

  <project Name="ARM_kit">

    <!-- ============================================================
         Common settings shared by all configurations
         ============================================================ -->
    <configuration
      Name="Common"
      LIBRARY_IO_TYPE="RTT"
      arm_compiler_variant="SEGGER"
      arm_endian="Little"
      arm_linker_heap_size="1024"
      arm_linker_process_stack_size="0"
      arm_linker_stack_size="2048"
      arm_linker_variant="SEGGER"
      arm_target_interface_type="SWD"
      debug_stack_pointer_start="__stack_end__"
      debug_start_from_entry_point_symbol="Yes"
      debug_target_connection="GDB Server"
      gcc_entry_point="Reset_Handler"
      gdb_server_autostart_server="Yes"
      gdb_server_command_line="/Library/STMicroelectronics/STM32Tools/gdbserver/bin/ST-LINK_gdbserver -d -cp &quot;/Library/STMicroelectronics/STM32Tools/cubeprogrammer/bin&quot; -e -r 10"
      gdb_server_port="61234"
      project_directory=""
      project_type="Executable"
      target_reset_script="Reset();" />

    <!-- ============================================================
         F411 – NUCLEO-F411RE + SPSE shield
         ============================================================ -->
    <configuration
      Name="F411 Debug"
      Target="STM32F411RETx"
      arm_architecture="v7EM"
      arm_core_type="Cortex-M4"
      arm_fp_abi="Hard"
      arm_fpu_type="FPv4-SP-D16"
      arm_simulator_memory_simulation_parameter="ROM;0x08000000;0x00080000;RAM;0x20000000;0x00020000"
      arm_target_device_name="STM32F411RE"
      c_preprocessor_definitions="ARM_MATH_CM4;STM32F411xE;__STM32F411_SUBFAMILY;__STM32F4XX_FAMILY;DEBUG"
      c_user_include_directories="$(ProjectDir)/include;$(ProjectDir)/CMSIS_5/CMSIS/Core/Include;$(ProjectDir)/STM32F4xx/Device/Include"
      debug_register_definition_file="$(ProjectDir)/STM32F411_Registers.xml"
      gcc_debugging_level="Level 3"
      gcc_optimization_level="None"
      link_linker_script_file="$(ProjectDir)/STM32F4xx_Flash.icf"
      linker_memory_map_file="$(ProjectDir)/STM32F411RETx_MemoryMap.xml"
      macros="DeviceHeaderFile=$(PackagesDir)/STM32F4xx/Device/Include/stm32f4xx.h;DeviceSystemFile=$(PackagesDir)/STM32F4xx/Device/Source/system_stm32f4xx.c;DeviceVectorsFile=$(PackagesDir)/STM32F4xx/Source/stm32f411xe_Vectors.s;DeviceFamily=STM32F4xx;DeviceSubFamily=STM32F411;Target=STM32F411RETx" />
    <configuration
      Name="F411 Release"
      Target="STM32F411RETx"
      arm_architecture="v7EM"
      arm_core_type="Cortex-M4"
      arm_fp_abi="Hard"
      arm_fpu_type="FPv4-SP-D16"
      arm_simulator_memory_simulation_parameter="ROM;0x08000000;0x00080000;RAM;0x20000000;0x00020000"
      arm_target_device_name="STM32F411RE"
      c_preprocessor_definitions="ARM_MATH_CM4;STM32F411xE;__STM32F411_SUBFAMILY;__STM32F4XX_FAMILY;NDEBUG"
      c_user_include_directories="$(ProjectDir)/include;$(ProjectDir)/CMSIS_5/CMSIS/Core/Include;$(ProjectDir)/STM32F4xx/Device/Include"
      debug_register_definition_file="$(ProjectDir)/STM32F411_Registers.xml"
      gcc_debugging_level="Level 2"
      gcc_optimization_level="Level 2 balanced"
      link_dedupe_code="Yes"
      link_linker_script_file="$(ProjectDir)/STM32F4xx_Flash.icf"
      linker_memory_map_file="$(ProjectDir)/STM32F411RETx_MemoryMap.xml"
      macros="DeviceHeaderFile=$(PackagesDir)/STM32F4xx/Device/Include/stm32f4xx.h;DeviceSystemFile=$(PackagesDir)/STM32F4xx/Device/Source/system_stm32f4xx.c;DeviceVectorsFile=$(PackagesDir)/STM32F4xx/Source/stm32f411xe_Vectors.s;DeviceFamily=STM32F4xx;DeviceSubFamily=STM32F411;Target=STM32F411RETx" />

    <!-- ============================================================
         F407 – STM32F4-DISCOVERY
         ============================================================ -->
    <configuration
      Name="F407 Debug"
      Target="STM32F407VGTx"
      arm_architecture="v7EM"
      arm_core_type="Cortex-M4"
      arm_fp_abi="Hard"
      arm_fpu_type="FPv4-SP-D16"
      arm_simulator_memory_simulation_parameter="ROM;0x08000000;0x00100000;RAM;0x20000000;0x00020000"
      arm_target_device_name="STM32F407VG"
      c_preprocessor_definitions="ARM_MATH_CM4;STM32F407xx;__STM32F407_SUBFAMILY;__STM32F4XX_FAMILY;DEBUG"
      c_user_include_directories="$(ProjectDir)/include;$(ProjectDir)/CMSIS_5/CMSIS/Core/Include;$(ProjectDir)/STM32F4xx/Device/Include"
      debug_register_definition_file="$(ProjectDir)/STM32F407_Registers.xml"
      gcc_debugging_level="Level 3"
      gcc_optimization_level="None"
      link_linker_script_file="$(ProjectDir)/STM32F4xx_Flash.icf"
      linker_memory_map_file="$(ProjectDir)/STM32F407VGTx_MemoryMap.xml"
      macros="DeviceHeaderFile=$(PackagesDir)/STM32F4xx/Device/Include/stm32f4xx.h;DeviceSystemFile=$(PackagesDir)/STM32F4xx/Device/Source/system_stm32f4xx.c;DeviceVectorsFile=$(PackagesDir)/STM32F4xx/Source/stm32f407xx_Vectors.s;DeviceFamily=STM32F4xx;DeviceSubFamily=STM32F407;Target=STM32F407VGTx" />
    <configuration
      Name="F407 Release"
      Target="STM32F407VGTx"
      arm_architecture="v7EM"
      arm_core_type="Cortex-M4"
      arm_fp_abi="Hard"
      arm_fpu_type="FPv4-SP-D16"
      arm_simulator_memory_simulation_parameter="ROM;0x08000000;0x00100000;RAM;0x20000000;0x00020000"
      arm_target_device_name="STM32F407VG"
      c_preprocessor_definitions="ARM_MATH_CM4;STM32F407xx;__STM32F407_SUBFAMILY;__STM32F4XX_FAMILY;NDEBUG"
      c_user_include_directories="$(ProjectDir)/include;$(ProjectDir)/CMSIS_5/CMSIS/Core/Include;$(ProjectDir)/STM32F4xx/Device/Include"
      debug_register_definition_file="$(ProjectDir)/STM32F407_Registers.xml"
      gcc_debugging_level="Level 2"
      gcc_optimization_level="Level 2 balanced"
      link_dedupe_code="Yes"
      link_linker_script_file="$(ProjectDir)/STM32F4xx_Flash.icf"
      linker_memory_map_file="$(ProjectDir)/STM32F407VGTx_MemoryMap.xml"
      macros="DeviceHeaderFile=$(PackagesDir)/STM32F4xx/Device/Include/stm32f4xx.h;DeviceSystemFile=$(PackagesDir)/STM32F4xx/Device/Source/system_stm32f4xx.c;DeviceVectorsFile=$(PackagesDir)/STM32F4xx/Source/stm32f407xx_Vectors.s;DeviceFamily=STM32F4xx;DeviceSubFamily=STM32F407;Target=STM32F407VGTx" />

    <!-- ============================================================
         G071 – NUCLEO-G071RB + SPSE shield
         ============================================================ -->
    <configuration
      Name="G071 Debug"
      Target="STM32G071RBTx"
      arm_architecture="v6M"
      arm_core_type="Cortex-M0+"
      arm_fp_abi="Soft"
      arm_fpu_type="None"
      arm_simulator_memory_simulation_parameter="ROM;0x08000000;0x00020000;RAM;0x20000000;0x00009000"
      arm_target_device_name="STM32G071RB"
      c_preprocessor_definitions="ARM_MATH_CM0PLUS;STM32G071xx;__STM32G071_SUBFAMILY;__STM32G0XX_FAMILY;__NO_FPU_ENABLE;DEBUG"
      c_user_include_directories="$(ProjectDir)/include;$(ProjectDir)/CMSIS_5/CMSIS/Core/Include;$(ProjectDir)/STM32G0xx/Device/Include"
      debug_register_definition_file="$(ProjectDir)/STM32G071_Registers.xml"
      gcc_debugging_level="Level 3"
      gcc_optimization_level="None"
      link_linker_script_file="$(ProjectDir)/STM32G0xx_Flash.icf"
      linker_memory_map_file="$(ProjectDir)/STM32G071RBTx_MemoryMap.xml"
      macros="DeviceHeaderFile=$(PackagesDir)/STM32G0xx/Device/Include/stm32g0xx.h;DeviceSystemFile=$(PackagesDir)/STM32G0xx/Device/Source/system_stm32g0xx.c;DeviceVectorsFile=$(PackagesDir)/STM32G0xx/Source/stm32g071xx_Vectors.s;DeviceFamily=STM32G0xx;DeviceSubFamily=STM32G071;Target=STM32G071RBTx" />
    <configuration
      Name="G071 Release"
      Target="STM32G071RBTx"
      arm_architecture="v6M"
      arm_core_type="Cortex-M0+"
      arm_fp_abi="Soft"
      arm_fpu_type="None"
      arm_simulator_memory_simulation_parameter="ROM;0x08000000;0x00020000;RAM;0x20000000;0x00009000"
      arm_target_device_name="STM32G071RB"
      c_preprocessor_definitions="ARM_MATH_CM0PLUS;STM32G071xx;__STM32G071_SUBFAMILY;__STM32G0XX_FAMILY;__NO_FPU_ENABLE;NDEBUG"
      c_user_include_directories="$(ProjectDir)/include;$(ProjectDir)/CMSIS_5/CMSIS/Core/Include;$(ProjectDir)/STM32G0xx/Device/Include"
      debug_register_definition_file="$(ProjectDir)/STM32G071_Registers.xml"
      gcc_debugging_level="Level 2"
      gcc_optimization_level="Level 2 balanced"
      link_dedupe_code="Yes"
      link_linker_script_file="$(ProjectDir)/STM32G0xx_Flash.icf"
      linker_memory_map_file="$(ProjectDir)/STM32G071RBTx_MemoryMap.xml"
      macros="DeviceHeaderFile=$(PackagesDir)/STM32G0xx/Device/Include/stm32g0xx.h;DeviceSystemFile=$(PackagesDir)/STM32G0xx/Device/Source/system_stm32g0xx.c;DeviceVectorsFile=$(PackagesDir)/STM32G0xx/Source/stm32g071xx_Vectors.s;DeviceFamily=STM32G0xx;DeviceSubFamily=STM32G071;Target=STM32G071RBTx" />

    <!-- ============================================================
         File tree
         ============================================================ -->
    <folder Name="CMSIS Files">
      <file file_name="STM32F4xx/Device/Include/stm32f4xx.h">
        <configuration Name="G071 Debug"   build_exclude_from_build="Yes" />
        <configuration Name="G071 Release" build_exclude_from_build="Yes" />
      </file>
      <file file_name="STM32F4xx/Device/Source/system_stm32f4xx.c">
        <configuration Name="Common"       default_code_section=".init" default_const_section=".init_rodata" />
        <configuration Name="G071 Debug"   build_exclude_from_build="Yes" />
        <configuration Name="G071 Release" build_exclude_from_build="Yes" />
      </file>
      <file file_name="STM32G0xx/Device/Include/stm32g0xx.h">
        <configuration Name="F411 Debug"   build_exclude_from_build="Yes" />
        <configuration Name="F411 Release" build_exclude_from_build="Yes" />
        <configuration Name="F407 Debug"   build_exclude_from_build="Yes" />
        <configuration Name="F407 Release" build_exclude_from_build="Yes" />
      </file>
      <file file_name="STM32G0xx/Device/Source/system_stm32g0xx.c">
        <configuration Name="Common"       default_code_section=".init" default_const_section=".init_rodata" />
        <configuration Name="F411 Debug"   build_exclude_from_build="Yes" />
        <configuration Name="F411 Release" build_exclude_from_build="Yes" />
        <configuration Name="F407 Debug"   build_exclude_from_build="Yes" />
        <configuration Name="F407 Release" build_exclude_from_build="Yes" />
      </file>
    </folder>

    <folder Name="Script Files">
      <file file_name="STM32F4xx/Scripts/STM32F4xx_Target.js">
        <configuration Name="Common"       file_type="Reset Script" />
        <configuration Name="G071 Debug"   build_exclude_from_build="Yes" />
        <configuration Name="G071 Release" build_exclude_from_build="Yes" />
      </file>
      <file file_name="STM32G0xx/Scripts/STM32G0xx_Target.js">
        <configuration Name="Common"       file_type="Reset Script" />
        <configuration Name="F411 Debug"   build_exclude_from_build="Yes" />
        <configuration Name="F411 Release" build_exclude_from_build="Yes" />
        <configuration Name="F407 Debug"   build_exclude_from_build="Yes" />
        <configuration Name="F407 Release" build_exclude_from_build="Yes" />
      </file>
    </folder>

    <folder Name="Source Files">
      <configuration Name="Common" filter="c;cpp;cxx;cc;h;s;asm;inc" />

      <folder Name="examples">
        <configuration Name="Common" build_exclude_from_build="Yes" />
        <file file_name="examples/example_01-externalLED_01.c" />
        <file file_name="examples/example_01-externalLED_02-SysTick.c" />
        <file file_name="examples/example_02-userButton_01-controlLED.c" />
        <file file_name="examples/example_03-LCD_01.c" />
        <file file_name="examples/example_03-LCD_02-customChar.c" />
        <file file_name="examples/example_03-LCD_I2C_01.c" />
        <file file_name="examples/example_04-KPAD_01.c" />
        <file file_name="examples/example_05-HWtest_all.c" />
      </folder>

      <folder Name="include">
        <folder Name="boards">
          <file file_name="include/boards/board_disco_f407vg.h" />
          <file file_name="include/boards/board_nucleo_f411re.h" />
          <file file_name="include/boards/board_nucleo_g071rb.h" />
          <file file_name="include/boards/shield_spse.h" />
        </folder>
        <file file_name="include/chrono.h" />
        <file file_name="include/I2C.h" />
        <file file_name="include/I2Cg.h" />
        <file file_name="include/kit.h" />
        <file file_name="include/KPAD.h" />
        <file file_name="include/KPADg.h" />
        <file file_name="include/LCD.h" />
        <file file_name="include/LCD_customChar_table.h" />
        <file file_name="include/LCD_I2C.h" />
        <file file_name="include/LCD_I2Cg.h" />
      </folder>

      <folder Name="src">
        <file file_name="src/main.c" />
      </folder>
    </folder>

    <folder Name="System Files">
      <file file_name="SEGGER_THUMB_Startup.s" />
      <file file_name="STM32F4xx/Source/stm32f411xe_Vectors.s">
        <configuration Name="Common"       file_type="Assembly" />
        <configuration Name="F407 Debug"   build_exclude_from_build="Yes" />
        <configuration Name="F407 Release" build_exclude_from_build="Yes" />
        <configuration Name="G071 Debug"   build_exclude_from_build="Yes" />
        <configuration Name="G071 Release" build_exclude_from_build="Yes" />
      </file>
      <file file_name="STM32F4xx/Source/stm32f407xx_Vectors.s">
        <configuration Name="Common"       file_type="Assembly" />
        <configuration Name="F411 Debug"   build_exclude_from_build="Yes" />
        <configuration Name="F411 Release" build_exclude_from_build="Yes" />
        <configuration Name="G071 Debug"   build_exclude_from_build="Yes" />
        <configuration Name="G071 Release" build_exclude_from_build="Yes" />
      </file>
      <file file_name="STM32F4xx/Source/STM32F4xx_Startup.s">
        <configuration Name="G071 Debug"   build_exclude_from_build="Yes" />
        <configuration Name="G071 Release" build_exclude_from_build="Yes" />
      </file>
      <file file_name="STM32G0xx/Source/stm32g071xx_Vectors.s">
